{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hear-one-device",
  "version": "0.4.0",
  "identifier": "com.naya.hod",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HearOneDevice",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0M0M5NERCNkE2MjM1OTMKUldTVE5XSnEyNVE4MUFvaUdieFp0SlNIVk5aWXJMdHJQSHhuUm1JallqV2ZLSjF1T0NmS1RkRUgK",
      "endpoints": [
        "https://github.com/naya1228/HearOneDevice/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
